{
  "name": "@quiver/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the Quiver public API (Robinhood Chain bridge quotes, Stock Token/USDG watchlist data, Trenches trending data, Launchpad tokens).",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": ["quiver", "robinhood-chain", "bridge", "layerzero", "stargate", "web3", "sdk"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/quvrsite/quiver-sdk.git"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
